{
    "required_api_version": "^2.0.0",
    "name": "Fake Data",
    "description": "Generates a wide range of valid fake data",
    "developer_name": "Mateus Pitura",
    "icon": "images/logo.png",
    "options": {
        "query_debounce": 0.2
    },
    "preferences": [
        {
            "id": "keyword",
            "type": "keyword",
            "name": "Fake Data",
            "default_value": "fd",
            "description": ""
        },
        {
            "id": "custom_emails",
            "type": "text",
            "name": "Emails",
            "description": "key=value records separated by semicolon (;): <key1>=<value1>;<key2>=<value2>",
            "default_value": "Personal=youremail+{random}@gmail.com"
        }
    ]
}
